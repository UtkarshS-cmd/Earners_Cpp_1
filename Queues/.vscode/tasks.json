{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run current C++ file",
            "dependsOn": [
                "compile current C++ file",
                "run current C++ file"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Compiles and runs the active C++ file"
        },
        {
            "label": "compile current C++ file",
            "type": "process",
            "command": "g++",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "run current C++ file",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": []
        }
    ]
}
